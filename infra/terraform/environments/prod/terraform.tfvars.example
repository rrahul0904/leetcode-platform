aws_region         = "us-east-1"
name               = "skillforge-prod"
availability_zones = ["us-east-1a", "us-east-1b"]
route53_zone_id    = "Z1234567890"
api_domain         = "api.example.com"
api_image          = "123456789012.dkr.ecr.us-east-1.amazonaws.com/skillforge-api:REPLACE_WITH_DIGESTED_TAG"
worker_image       = "123456789012.dkr.ecr.us-east-1.amazonaws.com/skillforge-worker:REPLACE_WITH_DIGESTED_TAG"
valkey_auth_token  = "REPLACE_THROUGH_SECURE_TF_VAR"
clerk_issuer       = "https://your-clerk-domain"
clerk_jwks_url     = "https://your-clerk-domain/.well-known/jwks.json"
jwt_audience       = "skillforge-api"

# Candidate code execution is a separate hostile-code plane. Do not expose
# candidate execution in production until this is enabled and a hardened AMI
# with runsc/containerd integration has been built and independently verified.
enable_execution_production_infrastructure = false
execution_node_ami_id                      = "ami-REPLACE_WITH_HARDENED_EXECUTION_AMI"
cluster_admin_principal_arn                = ""
eks_public_access_cidrs                    = []

# Add only trusted migration/operator security groups. Never add hostile
# execution-node security groups to this allow-list.
additional_execution_database_client_security_group_ids = []

tags = {
  Application = "skillforge"
  ManagedBy   = "terraform"
}
