# Host-side development defaults. Docker Compose supplies service-specific
# internal URLs and local-only credentials directly to each container.
RIGOR_ENVIRONMENT=development
RIGOR_DATABASE_URL=postgresql+psycopg://rigor:rigor_local_only@localhost:5434/rigor
RIGOR_OPERATIONAL_DATABASE_URL=postgresql+psycopg://rigor_readonly:rigor_readonly_local_only@localhost:5434/rigor
RIGOR_VALKEY_URL=redis://localhost:6381/0
RIGOR_ALLOWED_ORIGINS=["http://localhost:3001"]
RIGOR_OIDC_ISSUER=http://localhost:8002/local-oidc
RIGOR_OIDC_AUDIENCE=rigor-web
RIGOR_LOCAL_OIDC_ENABLED=true
RIGOR_LOCAL_OIDC_REDIRECT_URIS=["http://localhost:3001/auth/callback"]
RIGOR_EXECUTION_ADAPTER=LOCAL_FUNCTIONAL
RIGOR_AI_ADAPTER=DETERMINISTIC

# Optional host-side locations. Generated backups are ignored by Git.
RIGOR_BACKUP_ROOT=backups

# The complete Docker stack overrides execution with LOCAL_DOCKER and provides
# these values only inside trusted containers. Never reuse local-only passwords
# outside a developer machine.
# RIGOR_EXECUTOR_DATABASE_URL=postgresql+psycopg://rigor_executor:rigor_executor_local_only@postgres:5432/rigor
# RIGOR_LOCAL_PYTHON_RUNNER_URL=http://python-runner:8081
# RIGOR_LOCAL_SQL_RUNNER_URL=http://sql-runner:8082
# RIGOR_EXECUTION_WORKER_ID=local-docker-controller
# RIGOR_LOCAL_EXECUTION_PARALLELISM=4
