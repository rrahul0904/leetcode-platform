#!/usr/bin/env sh
set -eu

for dependency in docker git; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    echo "Required dependency is unavailable: $dependency" >&2
    exit 1
  fi
done

if ! docker compose version >/dev/null 2>&1; then
  echo "Docker Compose v2 is required." >&2
  exit 1
fi

checksum_file() {
  target=$1
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$target" | awk '{print $1}'
    return
  fi
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$target" | awk '{print $1}'
    return
  fi
  echo "A SHA-256 utility (sha256sum or shasum) is required." >&2
  exit 1
}

created_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
stamp=$(date -u +%Y%m%dT%H%M%SZ)
backup_root=${RIGOR_BACKUP_ROOT:-backups}
backup_dir="$backup_root/rigor-local-$stamp"
dump_file="$backup_dir/rigor.dump"
manifest_file="$backup_dir/manifest.env"

mkdir -p "$backup_dir"
docker compose up -d postgres >/dev/null

attempt=0
until docker compose exec -T postgres pg_isready -U rigor -d rigor >/dev/null 2>&1; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 30 ]; then
    echo "Application PostgreSQL did not become ready for backup." >&2
    exit 1
  fi
  sleep 1
done

schema_revision=$(docker compose exec -T postgres psql -U rigor -d rigor -Atc \
  "SELECT version_num FROM alembic_version;")
application_revision=$(git rev-parse --verify HEAD)

docker compose exec -T postgres pg_dump \
  -U rigor \
  -d rigor \
  -Fc \
  --no-owner > "$dump_file"

if [ ! -s "$dump_file" ]; then
  echo "PostgreSQL backup is empty." >&2
  exit 1
fi

dump_checksum=$(checksum_file "$dump_file")
cat > "$manifest_file" <<EOF
FORMAT_VERSION=1
CREATED_AT=$created_at
SCHEMA_REVISION=$schema_revision
APPLICATION_REVISION=$application_revision
DUMP_FILE=rigor.dump
DUMP_SHA256=$dump_checksum
EOF

printf '%s\n' "$backup_dir"
