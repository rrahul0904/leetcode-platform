#!/usr/bin/env sh
set -eu

artifact_root=${RIGOR_CAPACITY_ARTIFACT_ROOT:-artifacts/capacity}
mkdir -p "$artifact_root"

raw_result="$artifact_root/runner-capacity.json"
stats_result="$artifact_root/container-stats.txt"
summary_result="$artifact_root/capacity-summary.json"

# Exercise the same internal HTTP boundaries used by the local execution
# controller. The controlled scenario must complete without transport errors;
# the burst scenario records explicit backpressure instead of hiding it.
docker compose exec -T execution-controller python - <<'PY' > "$raw_result"
from __future__ import annotations

import json
import statistics
import time
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed
from uuid import uuid4


def percentile(values: list[float], quantile: float) -> float:
    if not values:
        return 0.0
    ordered = sorted(values)
    index = min(len(ordered) - 1, max(0, round((len(ordered) - 1) * quantile)))
    return ordered[index]


def invoke(runtime: str, index: int) -> dict[str, object]:
    execution_id = str(uuid4())
    if runtime == "python":
        url = "http://python-runner:8081/run"
        payload = {
            "schema_version": 1,
            "execution_id": execution_id,
            "attempt": 1,
            "source_code": "def solve(value):\n    return value * 2\n",
            "entrypoint": "solve",
            "tests": [{"id": f"python-{index}", "visibility": "public", "input": index}],
        }
        timeout = 20
    else:
        url = "http://sql-runner:8082/run"
        payload = {
            "schema_version": 1,
            "execution_id": execution_id,
            "attempt": 1,
            "source_code": "SELECT value FROM numbers ORDER BY value",
            "schema_sql": "CREATE TABLE numbers(value integer);",
            "seed_sql": f"INSERT INTO numbers VALUES ({index + 1}), ({index});",
            "statement_timeout_ms": 3000,
            "tests": [{"id": f"sql-{index}", "visibility": "public", "input": None}],
        }
        timeout = 30
    request = urllib.request.Request(
        url,
        data=json.dumps(payload, separators=(",", ":")).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    started = time.perf_counter()
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            body = json.load(response)
            http_status = response.status
    except urllib.error.HTTPError as exc:
        body = json.loads(exc.read().decode("utf-8"))
        http_status = exc.code
    elapsed_ms = (time.perf_counter() - started) * 1000
    return {
        "latency_ms": elapsed_ms,
        "http_status": http_status,
        "status": body.get("status"),
        "error_category": body.get("error_category"),
    }


def scenario(runtime: str, *, requests: int, concurrency: int) -> dict[str, object]:
    started = time.perf_counter()
    results: list[dict[str, object]] = []
    with ThreadPoolExecutor(max_workers=concurrency) as pool:
        futures = [pool.submit(invoke, runtime, index) for index in range(requests)]
        for future in as_completed(futures):
            results.append(future.result())
    elapsed = time.perf_counter() - started
    latencies = [float(item["latency_ms"]) for item in results]
    completed = sum(item["status"] == "COMPLETED" for item in results)
    capacity_rejections = sum(item["http_status"] == 503 for item in results)
    other_failures = len(results) - completed - capacity_rejections
    return {
        "runtime": runtime,
        "requests": requests,
        "concurrency": concurrency,
        "completed": completed,
        "capacity_rejections": capacity_rejections,
        "other_failures": other_failures,
        "elapsed_seconds": round(elapsed, 6),
        "throughput_per_second": round(len(results) / elapsed, 4) if elapsed else 0,
        "latency_ms": {
            "mean": round(statistics.fmean(latencies), 4) if latencies else 0,
            "p50": round(percentile(latencies, 0.50), 4),
            "p95": round(percentile(latencies, 0.95), 4),
            "p99": round(percentile(latencies, 0.99), 4),
            "max": round(max(latencies), 4) if latencies else 0,
        },
    }


results = {
    "schema_version": 1,
    "generated_at_epoch": int(time.time()),
    "scenarios": [
        scenario("python", requests=8, concurrency=2),
        scenario("python", requests=16, concurrency=8),
        scenario("sql", requests=6, concurrency=2),
        scenario("sql", requests=12, concurrency=6),
    ],
}
for item in results["scenarios"]:
    if item["concurrency"] <= 2 and item["other_failures"] != 0:
        raise SystemExit(f"Controlled capacity scenario failed: {item}")
    if item["concurrency"] <= 2 and item["completed"] != item["requests"]:
        raise SystemExit(f"Controlled capacity scenario was incomplete: {item}")
print(json.dumps(results, indent=2, sort_keys=True))
PY

docker stats --no-stream \
  --format '{{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.PIDs}}' \
  $(docker compose ps -q web api execution-controller python-runner sql-runner postgres execution-postgres valkey) \
  > "$stats_result"

python3 - "$raw_result" "$stats_result" "$summary_result" <<'PY'
from __future__ import annotations

import json
import pathlib
import sys

raw_path = pathlib.Path(sys.argv[1])
stats_path = pathlib.Path(sys.argv[2])
summary_path = pathlib.Path(sys.argv[3])
raw = json.loads(raw_path.read_text(encoding="utf-8"))
bootstrap_path = pathlib.Path("artifacts/bootstrap-seconds.txt")
bootstrap_seconds = None
if bootstrap_path.exists():
    bootstrap_seconds = float(bootstrap_path.read_text(encoding="utf-8").strip())
summary = {
    **raw,
    "bootstrap_seconds": bootstrap_seconds,
    "container_stats_file": str(stats_path),
    "interpretation": {
        "controlled_scenarios": "concurrency at or below declared runner concurrency must complete without infrastructure failures",
        "burst_scenarios": "capacity rejections are explicit backpressure and are reported separately from infrastructure errors",
    },
}
summary_path.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY

printf 'Capacity evidence written to %s\n' "$artifact_root"
