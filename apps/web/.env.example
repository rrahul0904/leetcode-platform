NEXT_PUBLIC_RIGOR_API_URL=http://localhost:8002
NEXT_PUBLIC_RIGOR_AUTH_MODE=local
NEXT_PUBLIC_RIGOR_OIDC_CLIENT_ID=rigor-web
NEXT_PUBLIC_RIGOR_OIDC_REDIRECT_URI=http://localhost:3001/auth/callback

# Production Clerk mode. The browser talks to the same-origin Vercel BFF; Clerk
# session tokens are minted server-side and are not copied into localStorage.
# NEXT_PUBLIC_RIGOR_AUTH_MODE=clerk
# NEXT_PUBLIC_RIGOR_API_URL=/api/backend
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_APP_URL=https://your-skillforge-domain
# RIGOR_BACKEND_ORIGIN=https://api.your-skillforge-domain
# CLERK_JWT_TEMPLATE=skillforge-api
