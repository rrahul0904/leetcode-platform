# Non-secret production defaults for the Vercel-hosted SkillForge candidate app.
# Secrets and provider credentials remain Vercel environment variables.
NEXT_PUBLIC_RIGOR_AUTH_MODE=clerk
NEXT_PUBLIC_RIGOR_API_URL=/api/backend
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
