{
  "expo": {
    "name": "Rigor",
    "slug": "rigor-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "rigor",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    }
  }
}
