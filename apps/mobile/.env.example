# Public mobile configuration only. Never place provider secrets or AWS credentials here.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8002
EXPO_PUBLIC_OIDC_ISSUER=http://127.0.0.1:8002/local-oidc
EXPO_PUBLIC_OIDC_CLIENT_ID=rigor-mobile-local

# Optional canonical web origin used when universal/app links are configured.
EXPO_PUBLIC_APP_ORIGIN=http://localhost:3001
