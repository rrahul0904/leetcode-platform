{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "RIGOR_BACKEND_ORIGIN"
        }
      ]
    },
    "api": {
      "root": "apps/api/",
      "framework": "fastapi",
      "entrypoint": "vercel_main:app",
      "functions": {
        "vercel_main.py": {
          "maxDuration": 300
        }
      }
    }
  },
  "env": {
    "NEXT_PUBLIC_RIGOR_AUTH_MODE": "clerk",
    "NEXT_PUBLIC_RIGOR_API_URL": "/api/backend",
    "RIGOR_ENVIRONMENT": "production",
    "RIGOR_LOCAL_OIDC_ENABLED": "false",
    "RIGOR_EXECUTION_ADAPTER": "VERCEL_SANDBOX",
    "RIGOR_CLERK_ISSUER": "https://cosmic-oarfish-9174.clerk.accounts.dev",
    "RIGOR_CLERK_JWKS_URL": "https://cosmic-oarfish-9174.clerk.accounts.dev/.well-known/jwks.json"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
