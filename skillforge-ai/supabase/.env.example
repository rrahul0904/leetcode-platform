# Edge Functions receive SUPABASE_URL and SUPABASE_ANON_KEY from the Supabase runtime.
# Configure these additional secrets for semantic embeddings and AI review.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# OPENAI_API_KEY is also accepted as a fallback credential name.
OPENAI_API_KEY=

# FastAPI target used by admin-import-webhook.
FASTAPI_URL=http://host.docker.internal:8000
